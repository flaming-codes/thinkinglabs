---
import { Image } from "astro:assets";
import portrait from "../../../assets/about/portrait-light.webp";
import PageShell from "../components/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";

const experience = [
  {
    company: "wild",
    location: "Vienna / hybrid",
    roles: [
      {
        title: "Innovation Director",
        period: "Jan 2026 - present",
        detail: "Leading applied AI and agentic product direction from opportunity framing through production delivery.",
      },
      {
        title: "Innovation Tech Lead",
        period: "Oct 2023 - Dec 2025",
        detail: "Led LLM-native product work, retrieval systems, rapid prototyping, and cross-functional technical delivery.",
      },
      {
        title: "Senior Frontend Developer",
        period: "Apr 2022 - Oct 2023",
        detail: "Built high-craft digital products across React frontends and Node.js services.",
      },
    ],
  },
  {
    company: "expressflow.com",
    location: "Vienna",
    roles: [
      {
        title: "Lead Full Stack Developer",
        period: "Jun 2020 - Apr 2022",
        detail: "Owned architecture, delivery, and operations for high-impact medical and logistics products.",
      },
      {
        title: "Head of Mobile",
        period: "Jul 2017 - Jun 2020",
        detail: "Led mobile product engineering across React Native, Swift, backend services, and release operations.",
      },
    ],
  },
  {
    company: "Kickscale",
    location: "Vienna",
    roles: [
      {
        title: "CTO",
        period: "Jun 2020 - Apr 2021",
        detail: "Built the startup's frontend, backend, and realtime notification platform from the ground up.",
      },
    ],
  },
] as const;
---

<PageShell class="cv-root">
  <div class="cv-screen-only"><SiteNav revealBadge={false} /></div>

  <article class="cv-document" aria-labelledby="cv-name">
    <section class="cv-sheet cv-opening" aria-label="Introduction">
      <figure class="cv-opening-portrait">
        <Image
          src={portrait}
          alt="Tom Schönmann smiling in warm side light"
          width={1024}
          height={1024}
          quality={88}
          priority
          class="cv-opening-image"
        />
        <h1 id="cv-name">Tom<br />Schönmann</h1>
      </figure>

      <div class="cv-opening-copy">
        <div class="cv-opening-statement">
          <p>Hi, I’m Tom, Innovation Director at wild.</p>
          <p>
            I turn new capabilities into things people can actually use: clear enough to make
            sense of, solid enough to last, and ambitious enough to be worth doing.
          </p>
        </div>

        <div class="cv-opening-index" aria-label="Document index">
          <a href="#trajectory">1 Trajectory</a>
          <a href="#practice">2 Practice</a>
          <a href="#contact">3 Contact</a>
        </div>
      </div>
    </section>

    <section class="cv-sheet cv-editorial" id="trajectory" aria-labelledby="trajectory-title">
      <header class="cv-editorial-title">
        <h2 id="trajectory-title">Trajectory.</h2>
      </header>

      <div class="cv-editorial-body cv-trajectory">
        {
          experience.map((entry) => (
            <section class="cv-company">
              <header>
                <h3>{entry.company}</h3>
                <p>{entry.location}</p>
              </header>

              <div class="cv-roles">
                {entry.roles.map((role) => (
                  <article class="cv-role">
                    <p class="cv-meta">{role.period}</p>
                    <h4>{role.title}</h4>
                    <p>{role.detail}</p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <p class="cv-page-mark" aria-hidden="true">2 / 3</p>
    </section>

    <section class="cv-sheet cv-editorial" id="practice" aria-labelledby="practice-title">
      <header class="cv-editorial-title">
        <h2 id="practice-title">Practice.</h2>
      </header>

      <div class="cv-editorial-body cv-practice">
        <section aria-labelledby="working-set-title">
          <h3 id="working-set-title">Working set</h3>
          <p>
            Agentic systems, generative AI, retrieval-augmented generation, technical leadership,
            product engineering, TypeScript, React, Node.js, React Native, and Swift.
          </p>
        </section>

        <section aria-labelledby="selected-work-title">
          <p class="cv-meta">Selected work</p>
          <h3 id="selected-work-title">Financial Health Assistant · Erste Bank</h3>
          <p>
            Spearheaded one of Europe's early consumer-facing banking assistants powered by large
            language models, connecting two centuries of institutional knowledge with current
            product information.
          </p>
          <p class="cv-soft">
            Other work has been recognised by Awwwards and the Creative Club Austria.
          </p>
        </section>

        <section aria-labelledby="education-title">
          <h3 id="education-title">Education</h3>
          <p>Computer Science, focus subject Media · University of Vienna · 2013 - 2017</p>
          <p class="cv-soft">Matura · BHAK Vienna 22 · 2009 - 2013</p>
        </section>

        <section id="contact" aria-labelledby="contact-title">
          <h3 id="contact-title">Contact</h3>
          <address>
            <a href="mailto:tom@wild.as">tom@wild.as</a>
            <a href="https://thinkinglabs.run">thinkinglabs.run</a>
            <a href="https://flaming.codes">flaming.codes</a>
            <a href="https://www.linkedin.com/in/tom-schönmann-487b97164">LinkedIn</a>
          </address>
          <p class="cv-soft">German · native<br />English · full professional<br />Spanish · limited working</p>
        </section>
      </div>

      <p class="cv-page-mark" aria-hidden="true">3 / 3</p>
    </section>
  </article>
</PageShell>

<style>
  :global(body) {
    --tl-bg: var(--tl-cv-paper);
    --tl-ink: var(--tl-cv-ink);
    --tl-muted: var(--tl-cv-ink-58);
    background: var(--tl-cv-paper);
    overflow-x: hidden;
    overflow-y: auto;
  }

  :global(.cv-root) {
    gap: 0;
    padding: 0;
  }

  .cv-document {
    margin: 0;
  }

  .cv-sheet {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--tl-cv-paper);
    color: var(--tl-cv-ink);
  }

  @supports (min-height: 100dvh) {
    .cv-sheet {
      min-height: 100dvh;
    }
  }

  .cv-opening {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.5rem;
  }

  .cv-opening-portrait {
    position: relative;
    height: calc(100vh - 1rem);
    margin: 0;
    overflow: hidden;
    background: var(--tl-media-bg);
  }

  :global(.cv-opening-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cv-opening h1 {
    position: absolute;
    right: auto;
    bottom: 0.5rem;
    left: 0.5rem;
    max-width: 7ch;
    margin: 0;
    color: var(--tl-media-ink);
    font-size: calc(var(--tl-type-display-sm) * 1.12);
    font-weight: var(--tl-type-heading-weight-strong);
    line-height: 0.86;
    letter-spacing: var(--tl-type-track-tight);
  }

  .cv-opening-copy {
    display: grid;
    min-height: calc(100vh - 1rem);
    padding: 0.5rem 0.5rem 0;
    grid-template-rows: 1fr auto 1fr;
  }

  .cv-meta {
    margin: 0;
    color: var(--tl-cv-ink-48);
    font-size: var(--tl-type-metadata-size-sm);
    font-weight: var(--tl-type-metadata-weight);
    line-height: 1.25;
    letter-spacing: var(--tl-type-metadata-track-loose);
    text-transform: uppercase;
  }

  .cv-opening-statement {
    display: flex;
    grid-row: 2;
    max-width: 21rem;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--tl-cv-ink-70);
    font-size: var(--tl-type-body-sm);
    line-height: var(--tl-type-line-body);
  }

  .cv-opening-statement p {
    margin: 0;
  }

  .cv-opening-statement p:first-child {
    color: var(--tl-cv-ink);
    font-weight: var(--tl-type-heading-weight-strong);
  }

  .cv-opening-index {
    display: flex;
    grid-row: 3;
    flex-direction: column;
    align-items: flex-start;
    align-self: end;
    gap: 0.15rem;
    font-size: var(--tl-type-body-xs);
  }

  .cv-opening-index a {
    transition: opacity var(--tl-motion-fast) var(--tl-ease-standard);
  }

  .cv-opening-index a:hover,
  .cv-opening-index a:focus-visible {
    opacity: 0.5;
  }

  .cv-editorial {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.5rem;
  }

  .cv-editorial-title {
    display: flex;
    max-width: 20rem;
    padding: 0.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .cv-editorial-title h2 {
    margin: 0;
    font-size: var(--tl-type-display-md);
    font-weight: var(--tl-type-heading-weight-strong);
    line-height: var(--tl-type-line-tight);
    letter-spacing: var(--tl-type-track-heading);
  }

  .cv-editorial-body {
    display: flex;
    width: 100%;
    max-width: 25rem;
    padding: 4rem 0.5rem;
    flex-direction: column;
    justify-content: center;
  }

  .cv-trajectory {
    gap: 3.5rem;
  }

  .cv-company {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-company > header h3,
  .cv-role h4,
  .cv-practice h3 {
    margin: 0;
    font-size: var(--tl-type-body-sm);
    font-weight: var(--tl-type-heading-weight-strong);
    line-height: 1.25;
  }

  .cv-company > header p {
    margin: 0.25rem 0 0;
    color: var(--tl-cv-ink-48);
    font-size: var(--tl-type-body-xs);
  }

  .cv-roles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-role {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .cv-role > p:last-child,
  .cv-practice section > p,
  .cv-practice address {
    max-width: 36ch;
    margin: 0;
    color: var(--tl-cv-ink-68);
    font-size: var(--tl-type-body-xs);
    line-height: 1.55;
  }

  .cv-practice {
    gap: 4rem;
  }

  .cv-practice section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cv-practice .cv-soft {
    color: var(--tl-cv-ink-48);
  }

  .cv-practice address {
    display: flex;
    flex-direction: column;
    font-style: normal;
  }

  .cv-practice address a {
    width: fit-content;
    text-decoration: underline;
    text-decoration-color: var(--tl-cv-ink-24);
    text-underline-offset: 0.2rem;
  }

  .cv-page-mark {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    margin: 0;
    color: var(--tl-cv-ink-48);
    font-size: var(--tl-type-metadata-size-sm);
  }

  @media (max-width: 767px) {
    .cv-opening,
    .cv-editorial {
      display: flex;
      min-height: 0;
      padding: 0.5rem;
      flex-direction: column;
    }

    .cv-opening-portrait {
      height: 72vh;
    }

    .cv-opening-copy {
      min-height: 70vh;
      padding-top: 2rem;
    }

    .cv-editorial-title {
      min-height: 55vh;
      padding-top: 5rem;
    }

    .cv-editorial-body {
      max-width: 30rem;
      padding: 4rem 0.5rem 8rem;
      justify-content: flex-start;
    }

    .cv-trajectory {
      gap: 4.5rem;
    }

    .cv-practice {
      gap: 5rem;
    }
  }

  @page {
    size: A4 portrait;
    margin: 0;
  }

  @media print {
    :global(html),
    :global(body) {
      width: 210mm;
      height: auto;
      background: var(--tl-cv-paper) !important;
    }

    :global(body) {
      overflow: visible !important;
    }

    :global(.tl-skip-link),
    .cv-screen-only {
      display: none !important;
    }

    .cv-document {
      width: 210mm;
    }

    .cv-sheet {
      width: 210mm;
      height: 297mm;
      min-height: 297mm;
      break-after: page;
      page-break-after: always;
      overflow: hidden;
    }

    .cv-sheet:last-child {
      break-after: auto;
      page-break-after: auto;
    }

    .cv-opening,
    .cv-editorial {
      padding: 2mm;
    }

    .cv-opening-portrait,
    .cv-opening-copy {
      height: 293mm;
      min-height: 293mm;
    }

    .cv-opening h1 {
      bottom: 2mm;
      left: 2mm;
      font-size: 34px;
    }

    .cv-opening-copy {
      padding: 4mm 4mm 0;
    }

    .cv-editorial-title {
      padding: 4mm;
    }

    .cv-editorial-body {
      max-width: 86mm;
      padding: 18mm 4mm;
    }

    .cv-trajectory {
      gap: 9mm;
    }

    .cv-company {
      gap: 4mm;
    }

    .cv-roles {
      gap: 4mm;
    }

    .cv-role {
      gap: 1.5mm;
    }

    .cv-practice {
      gap: 15mm;
    }

    .cv-page-mark {
      right: 4mm;
      bottom: 4mm;
    }

    a {
      color: inherit;
    }
  }
</style>
