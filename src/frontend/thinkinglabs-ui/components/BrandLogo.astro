    animation-delay: calc(var(--hdm-duration) * 0.36);
  }

  @keyframes hdm-pulse-converge-wave {
    0% { opacity: 0.65; stroke-width: 14px; }
    50% { opacity: 1; stroke-width: 18px; }
    100% { opacity: 0.65; stroke-width: 14px; }
  }

  @keyframes hdm-pulse-converge-equator-wave {
    0% { opacity: 0.65; stroke-width: 14px; scale: 1 1; }
    50% { opacity: 1; stroke-width: 21px; scale: 1.06 1; }
    100% { opacity: 0.65; stroke-width: 14px; scale: 1 1; }
  }

  /* -------------------------------------------------------------------------
     5. Whisper Shimmer (Level 1 · Subtle)
     Resting opacity 0.88 -> Peak 1.0, Stroke 14px -> 15.5px
     ------------------------------------------------------------------------- */
  .tl-brand-emblem[data-motion="pulse-subtle"] .tl-hdm-rib {
    opacity: 0.88;
  }

  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib {
    animation: hdm-pulse-subtle-wave var(--hdm-duration) var(--tl-ease-standard) forwards;
  }

  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-1 { animation-delay: calc(var(--hdm-duration) * 0.00); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-2 { animation-delay: calc(var(--hdm-duration) * 0.07); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-3 { animation-delay: calc(var(--hdm-duration) * 0.14); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-4 { animation-delay: calc(var(--hdm-duration) * 0.21); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-5 { animation-delay: calc(var(--hdm-duration) * 0.28); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-6 { animation-delay: calc(var(--hdm-duration) * 0.35); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-subtle"] .tl-hdm-rib-7 { animation-delay: calc(var(--hdm-duration) * 0.42); }

  @keyframes hdm-pulse-subtle-wave {
    0% { opacity: 0.88; stroke-width: 14px; }
    50% { opacity: 1; stroke-width: 15.5px; }
    100% { opacity: 0.88; stroke-width: 14px; }
  }

  /* -------------------------------------------------------------------------
     6. Resonant Double-Echo (Harmonic Rebound)
     Primary cascade followed by secondary harmonic echo
     ------------------------------------------------------------------------- */
  .tl-brand-emblem[data-motion="pulse-echo"] .tl-hdm-rib {
    opacity: 0.70;
  }

  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib {
    animation: hdm-pulse-echo-wave calc(var(--hdm-duration) * 1.25) var(--tl-ease-standard) forwards;
  }

  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-1 { animation-delay: calc(var(--hdm-duration) * 0.00); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-2 { animation-delay: calc(var(--hdm-duration) * 0.08); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-3 { animation-delay: calc(var(--hdm-duration) * 0.16); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-4 { animation-delay: calc(var(--hdm-duration) * 0.24); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-5 { animation-delay: calc(var(--hdm-duration) * 0.32); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-6 { animation-delay: calc(var(--hdm-duration) * 0.40); }
  :is(.tl-brand-emblem:hover, .tl-brand-emblem.is-hovered, :global(.tl-brand-link:hover) .tl-brand-emblem, :global(label:hover) .tl-brand-emblem)[data-motion="pulse-echo"] .tl-hdm-rib-7 { animation-delay: calc(var(--hdm-duration) * 0.48); }

  @keyframes hdm-pulse-echo-wave {
    0% { opacity: 0.70; stroke-width: 14px; }
    30% { opacity: 1; stroke-width: 18px; }
    52% { opacity: 0.74; stroke-width: 14px; }
    74% { opacity: 0.94; stroke-width: 16.5px; }
    100% { opacity: 0.70; stroke-width: 14px; }
  }

  /* -------------------------------------------------------------------------
     7. High-Frequency Ion Scan (Snappy Laser)
     Fast duration, tight stagger, crisp laser attack
     ------------------------------------------------------------------------- */
